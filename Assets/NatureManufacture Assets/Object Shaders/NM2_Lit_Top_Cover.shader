            float3 linearRGBLo = In / 12.92;
            float3 linearRGBHi = pow(max(abs((In + 0.055) / 1.055), 1.192092896e-07), float3(2.4, 2.4, 2.4));
            Out = float3(In <= 0.04045) ? linearRGBLo : linearRGBHi;
        }
        
