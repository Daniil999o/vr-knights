\cf5\f1\lang1049\par
\f0\lang1033 Code examples:\par
\f1\lang1049\par
\b Decal at the shot point (for example, on the character) may have problems with moved object.\par
\b0 Unfortunately, there is no way to add a blood decal withoit visible arefacts to any object with different shaders and different UV.\par
Therefore, the only method is to attach the decal as child to a bone or object. But this will produce visual artifacts (when the decal moves separately from the mesh).\par
I use follow code for find nearest bone in the hit point:\par
\par
\cf6\i Transform GetNearestBone(Transform characterTransform, Vector3 hitPos)\par
\{\par
    var closestPos = 10f;\par
    Transform closestBone = null;\par
    var childs = characterTransform.GetComponentsInChildren<Transform>();\par
\par
    foreach (var child in childs)\par
    \{\par
        var dist = Vector3.Distance(child.position, hitPos);\par
        if (dist < closestPos)\par
        \{\par
            closestPos = dist;\par
            closestBone = child;\par
        \}\par
    \}\par
\par
    var distRoot = Vector3.Distance(characterTransform.position, hitPos);\par
    if (distRoot < closestPos)\par
    \{\par
        closestPos = distRoot;\par
        closestBone = characterTransform;\par
    \}\par
    return closestBone;\par
\}\par
\cf5\i0\par
\par
\b\f0\lang1033 How to \f1\lang1049 create blood splashes at mouse position (by left mouse button click)\par
\b0\par
\cf6\i if (Input.GetMouseButtonDown(0)) \par
\{\par
    var ray = Camera.main.ScreenPointToRay(Input.mousePosition);\par
    RaycastHit hit;\par
    if (Physics.Raycast(ray, out hit))\par
    \{\par
        var nearestBone = GetNearestObject(hit.transform.root, hit.point);\par
        if(nearestBone == null) return;\par
\par
        var attachedBloodInstance = Instantiate(attachedBloodDecal, nearestBone);\par
        var bloodT = attachedBloodInstance.transform;\par
        bloodT.position = hit.point;\par
        bloodT.localRotation = Quaternion.identity;\par
        bloodT.LookAt(hit.point + hit.normal, direction);\par
        bloodT.Rotate(90, 0, 0);\par
        Destroy(attachBloodInstance, 20);\par
    \}\par
\}\par
}
